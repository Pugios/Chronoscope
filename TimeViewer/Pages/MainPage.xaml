<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:local="clr-namespace:TimeViewer"
    x:Class="TimeViewer.MainPage"
    x:Name="MainPageRoot">

    <Grid>
        <!-- Pie + legend on top, the day timeline spanning their full width below -->
        <Grid
            RowDefinitions="Auto,Auto"
            HorizontalOptions="Center"
            VerticalOptions="Center">

            <HorizontalStackLayout
                Grid.Row="0"
                HorizontalOptions="Center">
                <VerticalStackLayout>
                    <lvc:PieChart
                        InitialRotation="-90"
                        SeriesSource="{Binding PieDataCollection}"
                        WidthRequest="{Binding PieSize}"
                        HeightRequest="{Binding PieSize}">
                        <lvc:PieChart.SeriesTemplate>
                            <DataTemplate
                                x:DataType="local:PieData">
                                <lvc:XamlPieSeries
                                    SeriesName="{Binding Name}"
                                    Values="{Binding Values}"
                                    ToolTipLabelFormatter="{Binding Formatter}"
                                    Fill="{Binding Fill}">
                                </lvc:XamlPieSeries>
                            </DataTemplate>
                        </lvc:PieChart.SeriesTemplate>
                    </lvc:PieChart>

                    <HorizontalStackLayout
                        HorizontalOptions="Center"
                        Spacing="10">
                        <Button
                            Text="&lt;&lt;"
                            Clicked="OnPrevWeekClicked" />
                        <Button
                            Text="&lt;"
                            Clicked="OnPrevDayClicked" />
                        <Label
                            Text="{Binding DisplayDay}"
                            VerticalTextAlignment="Center" />
                        <Button
                            Text="&#10227;"
                            Clicked="OnRefreshClicked" />
                        <Button
                            Text=">"
                            Clicked="OnNextDayClicked" />
                        <Button
                            Text=">>"
                            Clicked="OnNextWeekClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Columns fill top-to-bottom and grow to the right; UpdateLegendLayout caps the
                     height and hands out only as many columns as the window can spare, the rest
                     stay reachable through the horizontal scrollbar -->
                <CollectionView
                    x:Name="LegendView"
                    Margin="10"
                    ItemsSource="{Binding LegendItems}"
                    WidthRequest="{Binding LegendWidth}"
                    HeightRequest="{Binding LegendHeight}"
                    VerticalOptions="Center"
                    HorizontalScrollBarVisibility="Default"
                    VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout
                            x:Name="LegendLayout"
                            Orientation="Horizontal"
                            Span="1" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                            <DataTemplate
                                x:DataType="local:LegendItem">
                                <!-- Dot, name and duration share one row, all centred on it, so the
                                     dot cannot drift below the text. BackgroundColor is cleared
                                     because the global BoxView style would otherwise paint a square
                                     behind the rounded Color fill. -->
                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="6"
                                    Padding="0,0,10,0"
                                    WidthRequest="{Binding Source={x:Reference MainPageRoot}, Path=LegendColumnWidth}">
                                    <BoxView
                                        Grid.Column="0"
                                        Color="{Binding Color}"
                                        BackgroundColor="Transparent"
                                        WidthRequest="12"
                                        HeightRequest="12"
                                        CornerRadius="6"
                                        Margin="{Binding Indent}"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Name}"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding Duration}"
                                        HorizontalTextAlignment="End"
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </HorizontalStackLayout>

            <!-- Row 1: the bar, plus its own hover panel overlaid on top of it -->
            <Grid
                Grid.Row="1">
                <lvc:CartesianChart
                    x:Name="TimelineChart"
                    Margin="{Binding TimelineMargin}"
                    SeriesSource="{Binding TimelineDataCollection}"
                    ZoomMode="None"
                    LegendPosition="Hidden"
                    TooltipPosition="Hidden"
                    AnimationsSpeed="0:0:0"
                    HorizontalOptions="Fill"
                    HeightRequest="120">
                    <lvc:CartesianChart.GestureRecognizers>
                        <PointerGestureRecognizer
                            PointerMoved="OnTimelinePointerMoved"
                            PointerExited="OnTimelinePointerExited" />
                    </lvc:CartesianChart.GestureRecognizers>
                    <lvc:CartesianChart.SeriesTemplate>
                        <DataTemplate
                            x:DataType="local:TimelineData">
                            <lvc:XamlStackedRowSeries
                                SeriesName="{Binding Name}"
                                Values="{Binding Values}"
                                Fill="{Binding Fill}"
                                IsHoverable="False"
                                IsVisibleAtLegend="False"
                                Rx="0"
                                Ry="0"
                                Padding="0"
                                MaxBarWidth="60" />
                        </DataTemplate>
                    </lvc:CartesianChart.SeriesTemplate>
                    <lvc:CartesianChart.XAxes>
                        <lvc:AxesCollection>
                            <!-- MinLimit/MaxLimit are set in LoadDayTimelineAsync, not here -->
                            <lvc:XamlAxis
                                x:Name="TimelineXAxis"
                                TextSize="11"
                                ShowSeparatorLines="True" />
                        </lvc:AxesCollection>
                    </lvc:CartesianChart.XAxes>
                    <lvc:CartesianChart.YAxes>
                        <lvc:AxesCollection>
                            <lvc:XamlAxis
                                MinLimit="-0.5"
                                MaxLimit="0.5"
                                IsVisible="False"
                                ShowSeparatorLines="False" />
                        </lvc:AxesCollection>
                    </lvc:CartesianChart.YAxes>
                </lvc:CartesianChart>

                <Border
                    x:Name="TimelineTooltip"
                    IsVisible="{Binding TimelineHoverVisible}"
                    InputTransparent="True"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Padding="8,5"
                    BackgroundColor="#D9BFBFBF"
                    Stroke="#99808080"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 6">
                    <VerticalStackLayout
                        Spacing="1">
                        <Label
                            Text="{Binding TimelineHoverName}"
                            FontAttributes="Bold"
                            FontSize="12" />
                        <Label
                            Text="{Binding TimelineHoverRange}"
                            FontSize="12" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </Grid>

        <VerticalStackLayout
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="10"
            Spacing="4">
                <Button
                    Text="📌"
                    Clicked="OnPinClicked" />
                <Button
                    Text="⚙"
                    Clicked="OnSettingsClicked" />
                <Button
                    Text="📊"
                    Clicked="OnStatisticsClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
