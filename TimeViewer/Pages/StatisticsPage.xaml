<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
    xmlns:local="clr-namespace:TimeViewer"
    x:Class="TimeViewer.StatisticsPage"
    x:DataType="local:StatisticsPage"
    Title="Statistics">

    <Grid
        RowDefinitions="Auto,*"
        RowSpacing="10"
        Padding="20">

        <!-- Year navigation, same glyphs as MainPage's day controls. Indented to the grids' first
             column rather than centred on the window, which the left aligned charts would leave
             stranded out in the empty right half. -->
        <HorizontalStackLayout
            Grid.Row="0"
            Margin="38,0,0,0"
            HorizontalOptions="Start"
            Spacing="10">
            <Button
                Text="&lt;"
                Clicked="OnPrevYearClicked" />
            <Label
                Text="{Binding DisplayYear}"
                FontAttributes="Bold"
                VerticalTextAlignment="Center" />
            <Button
                Text="&#10227;"
                Clicked="OnRefreshClicked" />
            <Button
                Text=">"
                Clicked="OnNextYearClicked" />
            <!-- The same export every refresh already performs, on demand and loud about
                 what happened. See SettingsPage for the vault folder it writes to. -->
            <Button
                Text="Export to Vault"
                Clicked="OnExportClicked" />
        </HorizontalStackLayout>

        <Label
            Grid.Row="1"
            Text="{Binding EmptyMessage}"
            IsVisible="{Binding IsEmpty}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <!-- Both orientations: a 53 week grid plus the hour grid beside it is wider than the
             compact window the app is usually pinned at, so the charts scroll rather than squash -->
        <ScrollView
            Grid.Row="1"
            Orientation="Both">
            <VerticalStackLayout
                Spacing="18"
                BindableLayout.ItemsSource="{Binding TagStats}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate
                        x:DataType="local:TagStatistics">
                        <VerticalStackLayout
                            Spacing="6">

                            <!-- Title row, indented to line up with the grids' first column.
                                 BackgroundColor is cleared on every BoxView because the global
                                 style would otherwise paint a square behind the rounded fill. -->
                            <HorizontalStackLayout
                                Margin="38,0,0,0"
                                Spacing="8">
                                <BoxView
                                    Color="{Binding TagColor}"
                                    BackgroundColor="Transparent"
                                    WidthRequest="12"
                                    HeightRequest="12"
                                    CornerRadius="6"
                                    VerticalOptions="Center" />
                                <Label
                                    Text="{Binding Tag}"
                                    FontAttributes="Bold"
                                    VerticalOptions="Center" />
                                <Label
                                    Text="{Binding TotalLabel}"
                                    Opacity="0.7"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- This tag's grids, drawn left to right: Year Overview, then Active
                                 Hours. Both are HeatmapPanels, so the markup below is written once
                                 and the two element array instantiates it twice. -->
                            <HorizontalStackLayout
                                HorizontalOptions="Start"
                                Spacing="24"
                                BindableLayout.ItemsSource="{Binding Panels}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate
                                        x:DataType="local:HeatmapPanel">
                                        <VerticalStackLayout
                                            HorizontalOptions="Start"
                                            Spacing="4">

                                            <!-- Caption and scale strip are both indented by the
                                                 weekday gutter, so each one starts exactly at its
                                                 own grid's first column. -->
                                            <Label
                                                Text="{Binding Caption}"
                                                Margin="38,0,0,0"
                                                FontSize="12"
                                                Opacity="0.7" />

                                            <!-- Series, axes and DrawMargin all arrive built from
                                                 the code behind: the labelers close over the period
                                                 the grid covers, and pinning DrawMargin keeps the
                                                 plot area exactly the grid so the cells stay square
                                                 at any window width. Animating ~540 cells per tag
                                                 would only stutter, so the speed is zeroed like the
                                                 timeline's. -->
                                            <lvc:CartesianChart
                                                Series="{Binding Series}"
                                                XAxes="{Binding XAxes}"
                                                YAxes="{Binding YAxes}"
                                                DrawMargin="{Binding DrawMargin}"
                                                WidthRequest="{Binding ChartWidth}"
                                                HeightRequest="{Binding ChartHeight}"
                                                HorizontalOptions="Start"
                                                ZoomMode="None"
                                                LegendPosition="Hidden"
                                                TooltipPosition="Top"
                                                FindingStrategy="ExactMatch"
                                                AnimationsSpeed="0:0:0" />

                                            <!-- Drawn from the ramp itself, so it can never drift
                                                 from the shades in the grid above it. Each swatch
                                                 carries the span of tracked time it stands for: the
                                                 quartiles are per tag, per year AND per grid, so
                                                 "dark" means a heavy day here and a heavy hour
                                                 there. That is exactly what needs spelling out,
                                                 and why the two grids do not share one strip. -->
                                            <HorizontalStackLayout
                                                Margin="38,0,0,0"
                                                Spacing="4"
                                                BindableLayout.ItemsSource="{Binding ScaleSteps}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate
                                                        x:DataType="local:HeatmapScaleStep">
                                                        <VerticalStackLayout
                                                            Spacing="2">
                                                            <BoxView
                                                                Color="{Binding Color}"
                                                                BackgroundColor="Transparent"
                                                                WidthRequest="10"
                                                                HeightRequest="10"
                                                                CornerRadius="2"
                                                                HorizontalOptions="Center" />
                                                            <Label
                                                                Text="{Binding Label}"
                                                                FontSize="10"
                                                                Opacity="0.7"
                                                                HorizontalOptions="Center" />
                                                        </VerticalStackLayout>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
