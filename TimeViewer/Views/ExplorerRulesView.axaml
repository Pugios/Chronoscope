<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimeViewer.ViewModels"
             xmlns:local="using:TimeViewer"
             xmlns:conv="using:TimeViewer.Converters"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="TimeViewer.Views.ExplorerRulesView"
             x:DataType="vm:ExplorerRulesViewModel">

  <Grid RowDefinitions="Auto,*" RowSpacing="16" Margin="28,20,28,0">

    <!-- Header. The rules are a working copy until Confirm. -->
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Classes="Caption" Text="Tags  ›  Subprocesses" />
        <TextBlock Classes="PageTitle" Text="{Binding ProcessName}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Cancel" MinWidth="96" Height="34" Command="{Binding CancelCommand}" />
        <Button Classes="accent" MinWidth="96" Height="34" Command="{Binding ConfirmCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:FASymbolIcon Symbol="Checkmark" FontSize="16" />
            <TextBlock Text="Confirm" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="24" Margin="0,0,0,28">

        <!-- Rule Input -->
        <StackPanel>
          <TextBlock Classes="SectionTitle" Text="New rule" />
          <Border Classes="Card">
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="16" RowSpacing="12">
              <TextBlock Text="Column" VerticalAlignment="Center" Classes="Secondary" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <RadioButton GroupName="Column" Content="Name"
                             IsChecked="{Binding SelectedColumn, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Name}" />
                <RadioButton GroupName="Column" Content="DocName"
                             IsChecked="{Binding SelectedColumn, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=DocName}" />
                <RadioButton GroupName="Column" Content="Domain"
                             IsChecked="{Binding SelectedColumn, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Domain}" />
              </StackPanel>

              <TextBlock Grid.Row="1" Text="Match" VerticalAlignment="Center" Classes="Secondary" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="16">
                <RadioButton GroupName="Match" Content="Prefix"
                             IsChecked="{Binding SelectedMatchType, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Prefix}" />
                <RadioButton GroupName="Match" Content="Include"
                             IsChecked="{Binding SelectedMatchType, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Include}" />
                <RadioButton GroupName="Match" Content="Suffix"
                             IsChecked="{Binding SelectedMatchType, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=Suffix}" />
              </StackPanel>

              <TextBlock Grid.Row="2" Text="Pattern" VerticalAlignment="Center" Classes="Secondary" />
              <WrapPanel Grid.Row="2" Grid.Column="1" ItemSpacing="8" LineSpacing="8">
                <TextBox Text="{Binding Pattern}" PlaceholderText="Enter pattern..." Width="360" />
                <TextBlock Text="→" VerticalAlignment="Center" Classes="Secondary" />
                <ComboBox ItemsSource="{Binding AvailableTags}"
                          SelectedItem="{Binding SelectedTag}"
                          PlaceholderText="Select tag..." Width="160" />
                <TextBox Text="{Binding NewTag}" PlaceholderText="Or new tag..." Width="150" />
                <Button Classes="accent" Command="{Binding AddRuleCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:FASymbolIcon Symbol="Add" FontSize="16" />
                    <TextBlock Text="Add Rule" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </WrapPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- Existing Rules, first match wins -->
        <StackPanel>
          <TextBlock Classes="SectionTitle" Text="Rules  (first match wins)" />
          <Border Classes="Card" Padding="8">
            <Panel>
              <TextBlock Text="No rules yet - every activity keeps the process's own tag."
                         Classes="Secondary" Margin="8"
                         IsVisible="{Binding !ExplorerRules.Length}" />
              <ItemsControl ItemsSource="{Binding ExplorerRules}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:ExplorerRule">
                    <Border Padding="8,4" CornerRadius="4" Classes="RuleRow">
                      <Grid ColumnDefinitions="36,90,80,*,200,Auto" ColumnSpacing="12">
                        <TextBlock Text="{Binding Order, StringFormat='#{0}'}" Classes="Caption"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Column}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding MatchType}" VerticalAlignment="Center"
                                   Classes="Secondary" />
                        <TextBlock Grid.Column="3" Text="{Binding Pattern}" VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Pattern}" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                          <ui:FASymbolIcon Symbol="Tag" FontSize="14" Opacity="0.7" />
                          <TextBlock Text="{Binding Tag}" FontWeight="SemiBold"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2">
                          <Button Classes="Icon Subtle"
                                  ToolTip.Tip="Move up"
                                  Command="{Binding $parent[ItemsControl].((vm:ExplorerRulesViewModel)DataContext).MoveUpCommand}"
                                  CommandParameter="{Binding}">
                            <ui:FASymbolIcon Symbol="ChevronUp" />
                          </Button>
                          <Button Classes="Icon Subtle"
                                  ToolTip.Tip="Move down"
                                  Command="{Binding $parent[ItemsControl].((vm:ExplorerRulesViewModel)DataContext).MoveDownCommand}"
                                  CommandParameter="{Binding}">
                            <ui:FASymbolIcon Symbol="ChevronDown" />
                          </Button>
                          <Button Classes="Icon Subtle"
                                  ToolTip.Tip="Delete rule"
                                  Command="{Binding $parent[ItemsControl].((vm:ExplorerRulesViewModel)DataContext).DeleteRuleCommand}"
                                  CommandParameter="{Binding}">
                            <ui:FASymbolIcon Symbol="Delete" />
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.Styles>
                  <Style Selector="Border.RuleRow:pointerover">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                  </Style>
                </ItemsControl.Styles>
              </ItemsControl>
            </Panel>
          </Border>
        </StackPanel>

        <!-- Preview: what the rules above do to this process's history -->
        <StackPanel>
          <TextBlock Classes="SectionTitle" Text="Preview" />
          <Border Classes="Card" Padding="4">
            <DataGrid ItemsSource="{Binding PreviewRows}"
                      Height="440"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      SelectionMode="Single"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="*" x:DataType="vm:ExplorerPreviewRow" />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" x:DataType="vm:ExplorerPreviewRow" />
                <DataGridTextColumn Header="Doc Name" Binding="{Binding DocName}" Width="2*" x:DataType="vm:ExplorerPreviewRow" />
                <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*" x:DataType="vm:ExplorerPreviewRow" />
                <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="*" x:DataType="vm:ExplorerPreviewRow" />
                <DataGridTextColumn Header="Total Time" Binding="{Binding TotalTime}" Width="120"
                                    SortMemberPath="TotalSeconds" x:DataType="vm:ExplorerPreviewRow" />
                <DataGridTextColumn Header="Last Used" Binding="{Binding LastUsed}" Width="170"
                                    SortMemberPath="LastUsedDate" x:DataType="vm:ExplorerPreviewRow" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
