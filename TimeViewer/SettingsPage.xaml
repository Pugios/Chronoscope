<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TimeViewer"
    xmlns:controls="clr-namespace:Maui.ColorPicker;assembly=Maui.ColorPicker"
    xmlns:sf="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
    xmlns:data="clr-namespace:Syncfusion.Maui.Data;assembly=Syncfusion.Maui.Data"
    x:Class="TimeViewer.SettingsPage"
    Title="Settings">
    <ContentPage.Resources>
        <local:DateSortComparer
            x:Key="DateComparer" />
        <local:TotalSecondsSortComparer
            x:Key="TotalSecondsComparer" />
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout
            Spacing="20"
            Padding="20">
            <!-- Color Picker -->
            <FlexLayout
                BindableLayout.ItemsSource="{Binding TagColors}"
                Wrap="Wrap"
                JustifyContent="Start"
                AlignItems="Start">
                <BindableLayout.ItemTemplate>
                    <DataTemplate
                        x:DataType="local:TagColorRow">
                        <VerticalStackLayout
                            FlexLayout.Basis="200"
                            Padding="8,4">

                            <HorizontalStackLayout
                                Spacing="8">

                                <BoxView
                                    Color="{Binding Color}"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    CornerRadius="8"
                                    VerticalOptions="Center">
                                    <BoxView.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Tapped="OnColorTapped" />
                                    </BoxView.GestureRecognizers>
                                </BoxView>

                                <Label
                                    Text="{Binding Tag}"
                                    VerticalOptions="Center" />

                            </HorizontalStackLayout>

                            <Border
                                IsVisible="{Binding IsPickerVisible}"
                                Stroke="LightGray"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                Padding="8"
                                TranslationY="4">
                                <controls:ColorPicker
                                    x:Name="ColorPicker"
                                    WidthRequest="280"
                                    HeightRequest="140"
                                    ColorSpectrumStyle="TintToHueToShadeStyle"
                                    PickedColorChanged="ColorPicker_PickedColorChanged" />
                            </Border>

                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>

            <!-- Assign Tag to selected Rows -->
            <HorizontalStackLayout
                Spacing="10"
                VerticalOptions="Center">
                <Label
                    Text="Apply"
                    VerticalOptions="Center" />
                <Picker
                    ItemsSource="{Binding AvailableTags}"
                    SelectedItem="{Binding SelectedTag}"
                    Title="Select tag..."
                    WidthRequest="150" />
                <Entry
                    Placeholder="Or new tag..."
                    Text="{Binding NewTag}"
                    WidthRequest="150" />
                <Label
                    Text="to selected rows"
                    VerticalOptions="Center" />
                <Button
                    Text="Assign"
                    Clicked="OnAssignTagClicked" />
            </HorizontalStackLayout>

            <HorizontalStackLayout
                Spacing="10"
                VerticalOptions="Center">
                <!-- Save Button -->
                <Button
                    Text="Save"
                    Clicked="OnSaveClicked" />
                <!-- Make Explorer App -->
                <Button
                    Text="Configure Subprocesses"
                    Clicked="OnConfigSubprocessClicked" />
            </HorizontalStackLayout>

            <!-- Process Tag Table -->
            <sf:SfDataGrid
                x:Name="ProcessDataGrid"
                ItemsSource="{Binding ProcessRows}"
                AutoGenerateColumnsMode="None"
                HeightRequest="400"
                HorizontalOptions="Fill"
                DefaultStyle="{StaticResource DefaultDataGridStyle}"
                ColumnWidthMode="Fill"
                SortingMode="Single"
                SelectionUnit="Row"
                SelectionMode="Extended">

                <sf:SfDataGrid.SortComparers>
                    <data:SortComparer
                        Comparer="{StaticResource DateComparer}"
                        PropertyName="LastUsed" />
                    <data:SortComparer
                        Comparer="{StaticResource TotalSecondsComparer}"
                        PropertyName="TotalTime" />
                </sf:SfDataGrid.SortComparers>

                <sf:SfDataGrid.Columns>
                    <sf:DataGridTextColumn
                        HeaderText="Process"
                        MappingName="Process"
                        AllowFiltering="True" />
                    <sf:DataGridTextColumn
                        HeaderText="Tag"
                        MappingName="Tag"
                        AllowFiltering="True" />
                    <sf:DataGridTextColumn
                        Width="100"
                        HeaderText="Total Time"
                        MappingName="TotalTime" />
                    <sf:DataGridTextColumn
                        Width="150"
                        HeaderText="Last Used"
                        MappingName="LastUsed" />
                </sf:SfDataGrid.Columns>
            </sf:SfDataGrid>
            
            <!-- ManicTime Path -->
            <HorizontalStackLayout
                Spacing="10"
                VerticalOptions="Center">
                <Label
                    Text="mtc.exe:"
                    VerticalOptions="Center" />
                <Label
                    Text="{Binding MtcExePath}"
                    VerticalOptions="Center" />
                <Button
                    Text="Browse..."
                    Clicked="OnBrowseMtcClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>