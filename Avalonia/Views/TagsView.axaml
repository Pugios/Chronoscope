<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimeViewer.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="900"
             x:Class="TimeViewer.Views.TagsView"
             x:DataType="vm:TagsViewModel">

  <Grid RowDefinitions="Auto,*" RowSpacing="16" Margin="28,20,28,0">

    <!-- Header. Nothing is written until Save; leaving any other way discards the edits. -->
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Classes="PageTitle" Text="Tags" />
        <TextBlock Classes="Secondary" Text="Which tag each process counts toward, and how each tag is drawn" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ui:FAProgressRing IsActive="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           Width="22" Height="22" Margin="0,0,8,0" />
        <ui:FAInfoBadge Value="{Binding PendingChangeCount}"
                        IsVisible="{Binding PendingChangeCount}"
                        ToolTip.Tip="Unsaved tag assignments" />
        <Button Content="Discard" MinWidth="96" Height="34" Command="{Binding DiscardCommand}" />
        <Button Classes="accent" MinWidth="96" Height="34" Command="{Binding SaveCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:FASymbolIcon Symbol="Save" FontSize="16" />
            <TextBlock Text="Save" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="24" Margin="0,0,0,28">

        <!-- Tag colours -->
        <StackPanel>
          <TextBlock Classes="SectionTitle" Text="Tag colours" />
          <Border Classes="Card">
            <ItemsControl ItemsSource="{Binding TagColors}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel ItemSpacing="10" LineSpacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TagColorRow">
                  <Border Width="196" Padding="6,6,12,6" CornerRadius="6"
                          Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <ColorPicker Color="{Binding Color}" IsAlphaEnabled="False" />
                      <TextBlock Text="{Binding Tag}" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" MaxWidth="110"
                                 ToolTip.Tip="{Binding Tag}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>

        <!-- Process -> tag table -->
        <StackPanel>
          <TextBlock Classes="SectionTitle" Text="Processes" />
          <Border Classes="Card">
            <StackPanel Spacing="12">
              <WrapPanel ItemSpacing="10" LineSpacing="10">
                <TextBox Text="{Binding SearchText}" Width="240"
                         PlaceholderText="Search process or tag" VerticalAlignment="Center">
                  <TextBox.InnerLeftContent>
                    <ui:FASymbolIcon Symbol="Find" FontSize="16" Margin="8,0,0,0" Opacity="0.7" />
                  </TextBox.InnerLeftContent>
                </TextBox>

                <!-- Assign Tag to selected Rows -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Apply" VerticalAlignment="Center" />
                  <ComboBox ItemsSource="{Binding AvailableTags}"
                            SelectedItem="{Binding SelectedTag}"
                            PlaceholderText="Select tag..." Width="160" />
                  <TextBox Text="{Binding NewTag}" PlaceholderText="Or new tag..." Width="150" />
                  <TextBlock Text="to selected rows" VerticalAlignment="Center" />
                  <Button Command="{Binding AssignTagCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <ui:FASymbolIcon Symbol="Tag" FontSize="16" />
                      <TextBlock Text="Assign" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>

                <!-- Make Explorer App -->
                <Button Command="{Binding ConfigureSubprocessesCommand}"
                        ToolTip.Tip="Split a multi-purpose app (browser, file manager) by what it had open">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ui:FASymbolIcon Symbol="Filter" FontSize="16" />
                    <TextBlock Text="Configure Subprocesses" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </WrapPanel>

              <DataGrid x:Name="ProcessGrid"
                        ItemsSource="{Binding ProcessRows}"
                        Height="440"
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        CanUserSortColumns="True"
                        CanUserResizeColumns="True"
                        SelectionMode="Extended"
                        GridLinesVisibility="None"
                        HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Process" Binding="{Binding Process}" Width="2*" x:DataType="vm:ProcessRow" />
                  <DataGridTextColumn Header="Tag" Binding="{Binding Tag}" Width="*" x:DataType="vm:ProcessRow" />
                  <DataGridTextColumn Header="Total Time" Binding="{Binding TotalTime}" Width="120"
                                      SortMemberPath="TotalSeconds" x:DataType="vm:ProcessRow" />
                  <DataGridTextColumn Header="Last Used" Binding="{Binding LastUsed}" Width="170"
                                      SortMemberPath="LastUsedDate" x:DataType="vm:ProcessRow" />
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </Border>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
