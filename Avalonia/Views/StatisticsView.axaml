<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimeViewer.ViewModels"
             xmlns:local="using:TimeViewer"
             xmlns:conv="using:TimeViewer.Converters"
             xmlns:controls="using:TimeViewer.Controls"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="TimeViewer.Views.StatisticsView"
             x:DataType="vm:StatisticsViewModel">

  <Grid RowDefinitions="Auto,*" RowSpacing="16" Margin="28,20,28,0">

    <!-- Header: the year on screen, and the controls that move it -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Classes="PageTitle" Text="Statistics" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <ui:FAProgressRing IsActive="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                           Width="22" Height="22" Margin="0,0,10,0" />
        <Button Classes="Icon" Command="{Binding PrevYearCommand}" ToolTip.Tip="Previous year">
          <ui:FASymbolIcon Symbol="ChevronLeft" />
        </Button>
        <TextBlock Text="{Binding DisplayYear}" FontSize="18" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="10,0" />
        <Button Classes="Icon" Command="{Binding NextYearCommand}" ToolTip.Tip="Next year">
          <ui:FASymbolIcon Symbol="ChevronRight" />
        </Button>
        <Button Classes="Icon" Margin="8,0,0,0" Command="{Binding RefreshCommand}"
                ToolTip.Tip="Reload from ManicTime">
          <ui:FASymbolIcon Symbol="Refresh" />
        </Button>
        <!-- The same export every refresh already performs, on demand and loud about
             what happened. See Settings for the vault folder it writes to. -->
        <Button Classes="accent" Height="34" Margin="4,0,0,0" Command="{Binding ExportCommand}"
                ToolTip.Tip="Write the heatmap data into your Obsidian vault">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:FASymbolIcon Symbol="Share" FontSize="16" />
            <TextBlock Text="Export to Vault" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="8" IsVisible="{Binding IsEmpty}"
                HorizontalAlignment="Center" VerticalAlignment="Center">
      <ui:FASymbolIcon Symbol="CalendarEmpty" FontSize="40"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
      <TextBlock Text="{Binding EmptyMessage}" Classes="Secondary" />
    </StackPanel>

    <!-- Both orientations: a 53 week grid plus the hour grid beside it is wider than the
         compact window the app is usually pinned at, so the charts scroll rather than squash -->
    <ScrollViewer x:Name="StatsScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="24" Margin="0,0,0,24">
      <!-- The cards are stacked by their DisplayIndex, and a hidden one is collapsed, so
           rearranging never unloads a card's charts (see OrderedStackPanel) -->
      <ItemsControl x:Name="TagCards" ItemsSource="{Binding TagStats}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:OrderedStackPanel Spacing="12" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.Styles>
          <Style Selector="ContentPresenter" x:DataType="local:TagStatistics">
            <Setter Property="controls:OrderedStackPanel.Order" Value="{Binding DisplayIndex}" />
            <Setter Property="IsVisible" Value="{Binding !IsHidden}" />
          </Style>
        </ItemsControl.Styles>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:TagStatistics">
            <Border Classes="Card" HorizontalAlignment="Left" Padding="16,14">
              <StackPanel Spacing="10">

                <!-- Title row, indented to line up with the grids' first column; the card's own
                     arrange buttons sit at its right end -->
                <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="38,0,0,0">
                  <Ellipse Width="12" Height="12" VerticalAlignment="Center"
                           Fill="{Binding TagColor, Converter={x:Static conv:ColorConverters.ToBrush}}" />
                  <TextBlock Text="{Binding Tag}" FontSize="16" FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding TotalLabel}" Classes="Secondary"
                             VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                  <Button Classes="Icon Subtle MoveUp"
                          ToolTip.Tip="Move up" IsEnabled="{Binding CanMoveUp}">
                    <ui:FASymbolIcon Symbol="ChevronUp" />
                  </Button>
                  <Button Classes="Icon Subtle MoveDown"
                          ToolTip.Tip="Move down" IsEnabled="{Binding CanMoveDown}">
                    <ui:FASymbolIcon Symbol="ChevronDown" />
                  </Button>
                  <Button Classes="Icon Subtle Hide"
                          ToolTip.Tip="Hide this tag">
                    <ui:FASymbolIcon Symbol="Remove" />
                  </Button>
                </StackPanel>
                </Grid>

                <!-- This tag's grids, drawn left to right: Year Overview, then Active Hours. They
                     arrive a moment after the card itself (see FillPanelsAsync); the minimum
                     height is theirs, so the page does not shift as they fill in. -->
                <ItemsControl ItemsSource="{Binding Panels}" MinHeight="172">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" Spacing="28" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:HeatmapPanel">
                      <StackPanel Spacing="4" HorizontalAlignment="Left">

                        <!-- Caption and scale strip are both indented by the weekday gutter, so
                             each one starts exactly at its own grid's first column -->
                        <TextBlock Text="{Binding Caption}" Classes="Caption" Margin="38,0,0,0" />

                        <!-- Series, axes and DrawMargin all arrive built from the view model: the
                             labelers close over the period the grid covers, and pinning DrawMargin
                             keeps the plot area exactly the grid so the cells stay square.
                             Animating ~540 cells per tag would only stutter. -->
                        <lvc:CartesianChart Series="{Binding Series}"
                                            controls:ChartPaints.OwnTooltip="True"
                                            XAxes="{Binding XAxes}"
                                            YAxes="{Binding YAxes}"
                                            DrawMargin="{Binding DrawMargin}"
                                            Width="{Binding ChartWidth}"
                                            Height="{Binding ChartHeight}"
                                            HorizontalAlignment="Left"
                                            ZoomMode="None"
                                            LegendPosition="Hidden"
                                            TooltipPosition="Top"
                                            FindingStrategy="ExactMatch"
                                            AnimationsSpeed="0:0:0" />

                        <!-- Drawn from the ramp itself, so it can never drift from the shades in
                             the grid above it. Each swatch carries the span of tracked time it
                             stands for: the quartiles are per tag, per year AND per grid. -->
                        <ItemsControl ItemsSource="{Binding ScaleSteps}" Margin="38,2,0,0">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:HeatmapScaleStep">
                              <StackPanel Spacing="2" MinWidth="30">
                                <Border Width="12" Height="12" CornerRadius="3"
                                        HorizontalAlignment="Center"
                                        Background="{Binding Color, Converter={x:Static conv:ColorConverters.ToBrush}}" />
                                <TextBlock Text="{Binding Label}" FontSize="10"
                                           Classes="Secondary" HorizontalAlignment="Center" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Hidden tags, set aside at the very bottom until brought back -->
      <!-- Capped at the visible width, so the chips wrap onto new lines instead of widening the
           page (the grids above scroll sideways, which would otherwise let this grow forever) -->
      <StackPanel IsVisible="{Binding HasHiddenTags}" HorizontalAlignment="Left"
                  MaxWidth="{Binding #StatsScroll.Viewport.Width}">
        <TextBlock Classes="SectionTitle" Text="Hidden tags" />
        <ItemsControl x:Name="HiddenChips" ItemsSource="{Binding HiddenTags}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="10" LineSpacing="10" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="local:HiddenTag">
              <Border Classes="Card" Padding="14,8,8,8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                           Fill="{Binding TagColor, Converter={x:Static conv:ColorConverters.ToBrush}}" />
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Tag}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalLabel}" Classes="Caption" />
                  </StackPanel>
                  <Button Classes="Show" Margin="6,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <ui:FASymbolIcon Symbol="Add" FontSize="14" />
                      <TextBlock Text="Show" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
