<wnd:FAAppWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:vm="using:TimeViewer.ViewModels"
                 xmlns:ui="using:FluentAvalonia.UI.Controls"
                 xmlns:wnd="using:FluentAvalonia.UI.Windowing"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
                 x:Class="TimeViewer.Views.MainWindow"
                 x:DataType="vm:MainWindowViewModel"
                 Icon="/Assets/appicon.ico"
                 Title="TimeViewer"
                 Width="1320" Height="860"
                 MinWidth="640" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 Topmost="{Binding IsPinned}">

  <ui:FANavigationView x:Name="NavView"
                       PaneDisplayMode="LeftCompact"
                       OpenPaneLength="220"
                       IsSettingsVisible="True"
                       IsBackButtonVisible="True"
                       IsBackEnabled="{Binding CanGoBack}"
                       ItemInvoked="OnItemInvoked"
                       BackRequested="OnBackRequested">
    <ui:FANavigationView.MenuItems>
      <ui:FANavigationViewItem x:Name="DayItem" Content="Day" Tag="Day" IconSource="Clock" />
      <ui:FANavigationViewItem x:Name="StatisticsItem" Content="Statistics" Tag="Statistics" IconSource="Calendar" />
      <ui:FANavigationViewItem x:Name="TagsItem" Content="Tags" Tag="Tags" IconSource="Tag" />
    </ui:FANavigationView.MenuItems>

    <!-- Keep the window above everything else, e.g. docked beside work -->
    <ui:FANavigationView.PaneFooter>
      <ToggleButton Classes="Icon"
                    Margin="4,0,4,4"
                    Width="40"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding IsPinned}"
                    ToolTip.Tip="Keep on top">
        <ui:FASymbolIcon Symbol="Pin" />
      </ToggleButton>
    </ui:FANavigationView.PaneFooter>

    <!-- The pages. Filled from code (ShowPage): the Day and Statistics views are kept here once
         built and only hidden while another page is shown, the others come and go per visit. -->
    <Panel x:Name="PageHost" />
  </ui:FANavigationView>
</wnd:FAAppWindow>
