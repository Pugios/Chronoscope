<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TimeViewer.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="TimeViewer.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <Grid RowDefinitions="Auto,*" RowSpacing="16" Margin="28,20,28,0">

    <!-- Header. Nothing is written until Save; leaving any other way discards the edits. -->
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel VerticalAlignment="Center">
        <TextBlock Classes="PageTitle" Text="Settings" />
        <TextBlock Classes="Secondary" Text="Where the data comes from, and where it goes" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Discard" MinWidth="96" Height="34" Command="{Binding DiscardCommand}" />
        <Button Classes="accent" MinWidth="96" Height="34" Command="{Binding SaveCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ui:FASymbolIcon Symbol="Save" FontSize="16" />
            <TextBlock Text="Save" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="24" Margin="0,0,0,28">
        <!-- Data sources -->
        <StackPanel Spacing="4">
          <TextBlock Classes="SectionTitle" Text="Data source" />

          <ui:FASettingsExpander Header="ManicTime command line (mtc.exe)"
                                 Description="{Binding MtcExePath}"
                                 IconSource="Code">
            <ui:FASettingsExpander.Footer>
              <Button Content="Browse..." Command="{Binding BrowseMtcCommand}" />
            </ui:FASettingsExpander.Footer>
          </ui:FASettingsExpander>

          <!-- Only the day view runs the timer; each refresh also rewrites the vault export -->
          <ui:FASettingsExpander Header="Refresh interval"
                                 Description="How often the day view reloads from ManicTime while it is open"
                                 IconSource="Refresh">
            <ui:FASettingsExpander.Footer>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <NumericUpDown Value="{Binding RefreshMinutes}" Width="140"
                               Minimum="{Binding MinRefreshMinutes}" Maximum="{Binding MaxRefreshMinutes}"
                               Increment="1" FormatString="0" ParsingNumberStyle="Integer" />
                <TextBlock Text="min" VerticalAlignment="Center" />
              </StackPanel>
            </ui:FASettingsExpander.Footer>
          </ui:FASettingsExpander>

        </StackPanel>

        <!-- Tagging files. settings.json itself stays in the app data folder: it is where these
             two paths are remembered. -->
        <StackPanel Spacing="4">
          <TextBlock Classes="SectionTitle" Text="Tagging files" />

          <ui:FASettingsExpander Header="Process tags (tags.csv)"
                                 Description="{Binding TagsCsvLocation}"
                                 IconSource="Tag">
            <ui:FASettingsExpander.Footer>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="Icon" Command="{Binding OpenTagsFolderCommand}" ToolTip.Tip="Show in folder">
                  <ui:FASymbolIcon Symbol="OpenFolder" />
                </Button>
                <Button Content="Default" Command="{Binding ResetTagsFileCommand}"
                        ToolTip.Tip="Use the file in the app data folder" />
                <Button Content="Browse..." Command="{Binding BrowseTagsFileCommand}" />
              </StackPanel>
            </ui:FASettingsExpander.Footer>
          </ui:FASettingsExpander>

          <ui:FASettingsExpander Header="Subprocess rules (explorer-processes.csv)"
                                 Description="{Binding ExplorerRulesCsvLocation}"
                                 IconSource="Filter">
            <ui:FASettingsExpander.Footer>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Classes="Icon" Command="{Binding OpenExplorerRulesFolderCommand}" ToolTip.Tip="Show in folder">
                  <ui:FASymbolIcon Symbol="OpenFolder" />
                </Button>
                <Button Content="Default" Command="{Binding ResetExplorerRulesFileCommand}"
                        ToolTip.Tip="Use the file in the app data folder" />
                <Button Content="Browse..." Command="{Binding BrowseExplorerRulesFileCommand}" />
              </StackPanel>
            </ui:FASettingsExpander.Footer>
          </ui:FASettingsExpander>
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="SectionTitle" Text="Export" />

          <!-- The folder must sit INSIDE the vault: dataviewjs' dv.io.load() only resolves
               vault-relative paths, so anything outside is unreachable from a note. -->
          <ui:FASettingsExpander Header="Export heatmap data to Obsidian"
                                 Description="Writes timeviewer-heatmap.json into a folder inside your vault whenever the data is loaded or a tag colour changes"
                                 IconSource="Share"
                                 IsExpanded="True">
            <ui:FASettingsExpander.Footer>
              <ToggleSwitch IsChecked="{Binding ObsidianExportEnabled}" />
            </ui:FASettingsExpander.Footer>
            <ui:FASettingsExpanderItem Content="Vault folder"
                                       Description="{Binding ObsidianExportPathDisplay}">
              <ui:FASettingsExpanderItem.Footer>
                <Button Content="Browse..." Command="{Binding BrowseVaultCommand}" />
              </ui:FASettingsExpanderItem.Footer>
            </ui:FASettingsExpanderItem>
            <!-- The export runs unattended, so this is the only place a failure shows up -->
            <ui:FASettingsExpanderItem Content="Last export"
                                       Description="{Binding ExportStatus}">
              <ui:FASettingsExpanderItem.Footer>
                <ui:FASymbolIcon Symbol="Important" FontSize="18" IsVisible="{Binding ExportFailed}"
                                 Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                 ToolTip.Tip="The latest export failed" />
              </ui:FASettingsExpanderItem.Footer>
            </ui:FASettingsExpanderItem>
          </ui:FASettingsExpander>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
